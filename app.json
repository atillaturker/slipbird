{
  "expo": {
    "name": "Slipbird",
    "slug": "slipbird",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "slipbird",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.atillaturker.slipbird",
      "buildNumber": "1",
      "supportsTablet": false,
      "icon": "./assets/images/icon.png",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.atillaturker.slipbird",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#0b6b4c",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_EXTERNAL_STORAGE"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#f2f3ef",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160,
          "dark": {
            "backgroundColor": "#0e1210",
            "image": "./assets/images/splash-icon.png"
          }
        }
      ],
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": [
              "en",
              "tr"
            ],
            "android": [
              "en",
              "tr"
            ]
          }
        }
      ],
      "expo-sqlite",
      "@react-native-community/datetimepicker",
      [
        "expo-camera",
        {
          "cameraPermission": "Slipbird uses the camera to scan receipts and invoice QR codes. Photos stay on this device.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Slipbird lets you import receipt photos from your library. Photos stay on this device.",
          "cameraPermission": "Slipbird uses the camera to scan receipts and invoice QR codes. Photos stay on this device.",
          "microphonePermission": false
        }
      ],
      [
        "react-native-document-scanner-plugin",
        {
          "cameraPermission": "Slipbird uses the camera to scan receipts and invoice QR codes. Photos stay on this device."
        }
      ],
      "expo-sharing",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#0b6b4c"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "description": "Scan receipts and e-invoices, see where your money goes.",
    "locales": {
      "en": "./locales/en.json",
      "tr": "./locales/tr.json"
    }
  }
}
