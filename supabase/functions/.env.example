# Copy to supabase/functions/.env for `supabase functions serve` (that file is git-ignored).
# In production: supabase secrets set PARSER_PROVIDER=... GROQ_MODEL=... GROQ_API_KEY=... GEMINI_MODEL=... GEMINI_API_KEY=...

# DEVELOPMENT ONLY — lifts the 15 parses/month limit so parsing can be tested freely (usage is still counted).
# Never set this in production: before release, `supabase secrets list` must not show PARSE_QUOTA_DISABLED.
PARSE_QUOTA_DISABLED=true

# Slipbird Pro: lets subscribers past the free monthly limit. RevenueCat → Project settings → API keys →
# secret key (never in the app). The app makes RevenueCat's user id the Supabase user id.
REVENUECAT_SECRET_KEY=
REVENUECAT_ENTITLEMENT=pro

# Ordered fallback chain: each request tries these in turn when one is busy or failing.
PARSER_PROVIDER=groq,gemini

# Groq (https://console.groq.com/keys) — OpenAI-compatible, strict JSON schema
GROQ_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=

# Gemini (https://aistudio.google.com/apikey) — current Flash-Lite id from https://ai.google.dev/gemini-api/docs/models
# (e.g. gemini-3.1-flash-lite as of Sep 2026)
GEMINI_MODEL=
GEMINI_API_KEY=
