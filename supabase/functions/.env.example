# Copy to supabase/functions/.env for `supabase functions serve` (that file is git-ignored).
# In production: supabase secrets set PARSER_PROVIDER=gemini PARSER_MODEL=... GEMINI_API_KEY=...
PARSER_PROVIDER=gemini
# Current Flash-Lite id from https://ai.google.dev/gemini-api/docs/models (e.g. gemini-3.1-flash-lite as of Sep 2026)
PARSER_MODEL=
GEMINI_API_KEY=
