# Copy to supabase/functions/.env for `supabase functions serve` (that file is git-ignored).
# In production: supabase secrets set PARSER_PROVIDER=... GROQ_MODEL=... GROQ_API_KEY=... GEMINI_MODEL=... GEMINI_API_KEY=...

# Ordered fallback chain: each request tries these in turn when one is busy or failing.
PARSER_PROVIDER=groq,gemini

# Groq (https://console.groq.com/keys) — OpenAI-compatible, strict JSON schema
GROQ_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=

# Gemini (https://aistudio.google.com/apikey) — current Flash-Lite id from https://ai.google.dev/gemini-api/docs/models
# (e.g. gemini-3.1-flash-lite as of Sep 2026)
GEMINI_MODEL=
GEMINI_API_KEY=
