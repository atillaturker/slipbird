# Copy to .env.local (git-ignored). Values come from `npx supabase start` (local) or the Supabase dashboard.
# The anon/publishable key is public by design; never put the Gemini (LLM) key here.
# Physical device: use your computer's LAN IP. Android emulator: http://10.0.2.2:54321
EXPO_PUBLIC_SUPABASE_URL=http://192.168.1.10:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# RevenueCat public SDK keys (Slipbird Pro). Leave empty to build without purchases (Pro stays off).
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
